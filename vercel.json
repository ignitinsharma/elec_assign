{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/app/**,data/*.csv.gz,data/metadata.json,data/bias_diagnostics.json}",
      "excludeFiles": "{backend/tests/**,backend/scripts/**,frontend/**,screenshots/**,scripts/**,data/validation_report.json,.venv/**,**/__pycache__/**,**/.pytest_cache/**,AGENTS.md,CLAUDE.md,DESIGN.md}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
